{
  "name": "saygrid",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run content:validate && npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "content:validate": "node --import tsx scripts/validate-content.ts",
    "content:manifest": "node --import tsx scripts/build-content-manifest.ts",
    "content:duplicates": "node --import tsx scripts/check-duplicates.ts",
    "content:report": "node --import tsx scripts/generate-content-report.ts",
    "content:import": "node --import tsx scripts/import-content-csv.ts",
    "content:perf": "node --import tsx scripts/generate-performance-data.ts"
  },
  "dependencies": {
    "@tanstack/react-virtual": "^3.14.9",
    "idb": "^8.0.3",
    "lucide-react": "^1.30.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "jsdom": "^29.1.1",
    "tsx": "^4.23.11",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.10"
  }
}
